# =============================================================
# .env.example — مركز الأحمدي للجوالات ومستلزماتها
# انسخ هذا الملف إلى .env.local وأضف القيم الحقيقية
# ⚠️  لا ترفع .env.local أبداً إلى GitHub
# =============================================================

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# الـ service_role في الخادم/Edge Functions فقط — لا يُكشف للمتصفح أبداً
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ===== URLs التطبيقات =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_DELIVERY_URL=http://localhost:3002

# ===== Stripe =====
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== المحافظ المحلية =====
JAWALI_API_KEY=
JAWALI_API_SECRET=
JAWALI_WEBHOOK_SECRET=
JEEB_API_KEY=
JEEB_API_SECRET=
JEEB_WEBHOOK_SECRET=

# ===== الإشعارات =====
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@ahmadi.ye
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ===== Meilisearch (المرحلة 1) =====
MEILISEARCH_URL=
MEILISEARCH_MASTER_KEY=
NEXT_PUBLIC_MEILISEARCH_URL=
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=

# ===== Sentry =====
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# ===== بيئة التشغيل =====
NODE_ENV=development
NEXT_PUBLIC_ENV=development
