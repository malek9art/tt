# ============================================================
# .env.example — مركز الأحمدي للجوالات
# انسخ إلى .env.local وأضف القيم — لا ترفع .env.local لـ GitHub
# ============================================================

# ===== Supabase (مطلوب) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# service_role في الخادم فقط — لا يُكشف للمتصفح أبداً
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===== URL التطبيق (مطلوب) =====
NEXT_PUBLIC_APP_URL=https://ahmadi-store.vercel.app

# ===== بيئة التشغيل =====
NODE_ENV=production
NEXT_PUBLIC_ENV=production

# ===== الإشعارات (اختياري) =====
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@ahmadi.ye

# ===== Twilio SMS (اختياري) =====
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# ===== Stripe (مستقبلاً) =====
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
