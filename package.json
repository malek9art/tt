    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.14.0"
