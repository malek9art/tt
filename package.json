{
  "name": "ahmadi-store",
  "version": "0.1.0",
  "private": true,
  "description": "مركز الأحمدي للجوالات ومستلزماتها — منصة التجارة الإلكترونية",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
